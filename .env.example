# ============================================================
# Salin file ini menjadi .env dan isi dengan nilai yang sesuai
# JANGAN commit file .env ke repository (sudah ada di .gitignore)
# ============================================================

# Kunci rahasia aplikasi - HARUS diubah di production!
# Generate dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-secret-key-yang-kuat-dan-acak-minimal-32-karakter

# URL Database
DATABASE_URL=sqlite:///instance/pengaduan.db

# Environment: development atau production
FLASK_ENV=development

# Password admin default (hanya untuk inisialisasi pertama)
ADMIN_PASSWORD=Admin@Pengaduan2025!
